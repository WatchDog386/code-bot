# Run after the project is written: typed into VS Code's terminal by the bot
# (or run in the background while you use the keyboard). "serve:" starts the app,
# "open:" shows it in VS Code's built-in browser, "# wait N" = seconds to give a command.
python -m venv .venv
{venv}python -m pip install -q -r requirements.txt   # wait 60
{venv}python -m pytest -q
serve: {venv}python -m uvicorn main:app --port 8000
open: http://127.0.0.1:8000/docs
