{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Invotech 360: dashboard (localhost:8765)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Invotech 360: dashboard + autostart",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "args": ["--autostart"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Invotech 360: terminal only",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/code_bot.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
